#!/usr/bin/env bun
// ship: the terminal's side of a /ship plan. It talks to the project's backend (the fixed steps: worktrees, merges, deploys,
// tests, PRs) over HTTP; the backend is picked per project from ~/.claude/ship/config.json. It never pushes or merges itself.
import { existsSync, mkdirSync, openSync, readdirSync, readFileSync, realpathSync, statSync, writeFileSync } from "node:fs";
import { createServer } from "node:net";
import { homedir } from "node:os";
import { dirname, join, normalize, resolve } from "node:path";

const HOME = join(homedir(), ".claude", "ship");
const CONFIG = process.env.SHIP_CONFIG ?? join(HOME, "config.json"); // SHIP_CONFIG: another config file, for tests
const argv = process.argv.slice(2), flag = (n: string) => { const i = argv.indexOf(n); if (i < 0) return undefined; const v = argv[i + 1]; argv.splice(i, 2); return v; };
let backendFlag = flag("--backend");
const [cmd, ...args] = argv;

interface Backend { builtin?: boolean; project?: any; url: string; api?: string; tokenPage?: string; tokenHeader?: string; about?: string }
interface Config { backends: Record<string, Backend>; projects: Record<string, string> } // projects: folder prefix -> backend name
const loadConfig = (): Config => { try { return JSON.parse(readFileSync(CONFIG, "utf8")); } catch { return { backends: {}, projects: {} }; } };
// A plan remembers its backend (ship register writes it), so later commands from any folder reach the same one.
const planFile = (id: string) => join(HOME, "plans", `${id}.json`);
function pickBackend(planId?: string): { name: string; b: Backend } {
  const cfg = loadConfig();
  let name = backendFlag ?? process.env.SHIP_BACKEND;
  if (!name && planId && existsSync(planFile(planId))) name = JSON.parse(readFileSync(planFile(planId), "utf8")).backend;
  if (!name) { const cwd = resolve(process.cwd()); name = Object.entries(cfg.projects).filter(([dir]) => cwd === dir || cwd.startsWith(dir + "/")).sort((a, b) => b[0].length - a[0].length)[0]?.[1]; }
  if (!name && Object.keys(cfg.backends).length === 1) name = Object.keys(cfg.backends)[0]; // one backend: it is the default
  if (!name) die(`no backend for ${process.cwd()}: add the folder under "projects" in ${CONFIG}, or pass --backend <name>`);
  const b = cfg.backends[name!] ?? die(`backend "${name}" is not in ${CONFIG}`);
  return { name: name!, b: b as Backend };
}
let BK: { name: string; b: Backend };
const URL_ = () => BK.b.url.replace(/\/$/, ""), API = () => `${URL_()}${BK.b.api ?? "/api/prflow"}`;
const die = (msg: string): never => { console.error(`ship: ${msg}`); process.exit(1); };
const out = (x: unknown) => console.log(typeof x === "string" ? x : JSON.stringify(x, null, 2));
const readJson = (path?: string) => {
  if (!path) die("give a JSON file (or - for stdin)");
  const text = path === "-" ? readFileSync(0, "utf8") : readFileSync(path!, "utf8");
  try { return JSON.parse(text); } catch (e: any) { return die(`${path} is not valid JSON: ${e.message}`); }
};

// The write token the backend puts on its page (tokenPage); read fresh each call and never printed.
let token = "";
async function tok(): Promise<string> {
  if (token || !BK.b.tokenPage) return token;
  const html = await fetch(`${URL_()}${BK.b.tokenPage}`).then((r) => r.text()).catch(() => die(`backend ${BK.name} is not answering on ${URL_()}`));
  token = /<meta name="td-token" content="([^"]+)"/.exec(html as string)?.[1] ?? die(`no page token on ${BK.b.tokenPage}`);
  return token;
}
async function call(method: "GET" | "POST", path: string, body?: unknown): Promise<any> {
  const headers: Record<string, string> = { "content-type": "application/json" };
  if (method === "POST" && BK.b.tokenPage) headers[BK.b.tokenHeader ?? "x-td-token"] = await tok();
  const r = await fetch(`${API()}${path}`, { method, headers, body: body === undefined ? undefined : JSON.stringify(body) }).catch((e) => die(`backend ${BK.name}: ${e.message}`));
  const text = await (r as Response).text();
  let j: any; try { j = JSON.parse(text); } catch { j = { ok: false, error: text.slice(0, 500) }; }
  if (!(r as Response).ok || j?.ok === false) die(j?.error ?? `HTTP ${(r as Response).status}`);
  return j;
}
const todo = (id: string) => call("GET", `/terminal/todo/${id}`);
const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
const need = (v: string | undefined, what: string) => v ?? die(`missing ${what}`);

function seenFile(id: string) { mkdirSync(join(HOME, "seen"), { recursive: true }); return join(HOME, "seen", `${BK.name}-${id}.json`); }

// The plugin's own page (ui/), served on this Mac with the backend's API behind /api/prflow.
// demo: made-up plans from ui/demo/, no backend needed (the README screenshot).
async function serveUi(port: number, demo = false): Promise<void> {
  const UI = join(dirname(realpathSync(process.argv[1]!)), "..", "ui"), api = BK?.b.api ?? "/api/prflow";
  Bun.serve({ hostname: "127.0.0.1", port, async fetch(req) {
    const u = new URL(req.url);
    if (demo && u.pathname.startsWith("/api/prflow")) {
      const rest = u.pathname.slice("/api/prflow".length);
      if (req.method !== "GET") return Response.json({ ok: false, error: "This is the demo: nothing changes." }, { status: 400 });
      if (rest === "/state" || rest === "/findings") return new Response(Bun.file(join(UI, "demo", `${rest.slice(1)}.json`)), { headers: { "content-type": "application/json" } });
      return Response.json(rest.endsWith("/events") ? [] : []);
    }
    if (u.pathname.startsWith("/api/prflow")) {
      const headers: Record<string, string> = { "content-type": req.headers.get("content-type") ?? "application/json" };
      if (req.method === "POST" && BK.b.tokenPage) headers[BK.b.tokenHeader ?? "x-td-token"] = await tok();
      const r = await fetch(`${URL_()}${api}${u.pathname.slice("/api/prflow".length)}${u.search}`, { method: req.method, headers, body: req.method === "GET" ? undefined : await req.text() }).catch(() => null);
      return r ? new Response(r.body, { status: r.status, headers: { "content-type": r.headers.get("content-type") ?? "application/json", "cache-control": "no-store" } }) : Response.json({ ok: false, error: `backend ${BK.name} is not answering` }, { status: 502 });
    }
    if (u.pathname === "/theme.css") return new Response("", { headers: { "content-type": "text/css" } }); // a host may override colours here
    const f = normalize(join(UI, u.pathname === "/" ? "index.html" : u.pathname));
    if (!f.startsWith(UI + "/") || !existsSync(f)) return new Response("not found", { status: 404 });
    return new Response(Bun.file(f), { headers: { "cache-control": "no-store" } });
  } });
  const url = `http://127.0.0.1:${port}/` + (demo ? "#view=P-03" : "");
  out(demo ? `ship-flow demo page: ${url}  (Ctrl+C to stop)` : `ship-flow page for backend ${BK.name}: ${url}  (Ctrl+C to stop)`);
  if (!process.env.SHIP_NO_OPEN) Bun.spawn([process.platform === "darwin" ? "open" : "xdg-open", url], { stdout: "ignore", stderr: "ignore" });
  await new Promise(() => {});
}

// ---- setup: find the repos and branches, write the built-in backend entry, start it ----
const sh = (cmd: string[], cwd: string): string => { const r = Bun.spawnSync(cmd, { cwd, stdout: "pipe", stderr: "pipe" }); return r.exitCode === 0 ? r.stdout.toString().trim() : ""; };
const isRepo = (d: string) => existsSync(join(d, ".git"));
function guessCommands(d: string): { build?: string; test?: string } {
  const has = (f: string) => existsSync(join(d, f));
  if (has("package.json")) {
    let scripts: Record<string, string> = {}; try { scripts = JSON.parse(readFileSync(join(d, "package.json"), "utf8")).scripts ?? {}; } catch {}
    const pm = has("bun.lock") || has("bun.lockb") ? "bun run" : has("pnpm-lock.yaml") ? "pnpm run" : has("yarn.lock") ? "yarn" : "npm run";
    return { build: scripts.build ? `${pm} build` : undefined, test: scripts.test ? (pm === "npm run" ? "npm test" : `${pm} test`) : undefined };
  }
  if (has("pom.xml")) return { build: "mvn -q -o verify" };
  if (has("build.gradle") || has("build.gradle.kts")) return { build: "./gradlew build" };
  if (has("go.mod")) return { test: "go test ./..." };
  if (has("Cargo.toml")) return { test: "cargo test" };
  if (has("pyproject.toml")) return { test: "pytest" };
  if (has("Makefile")) return { test: "make test" };
  return {};
}
function detectRepo(d: string) {
  const origin = sh(["git", "remote", "get-url", "origin"], d), current = sh(["git", "branch", "--show-current"], d);
  const refs = sh(["git", "for-each-ref", "--format=%(refname)", "refs/heads", "refs/remotes/origin"], d).split("\n").filter(Boolean);
  const local = refs.filter((r) => r.startsWith("refs/heads/")).map((r) => r.slice(11)), remote = refs.filter((r) => r.startsWith("refs/remotes/origin/") && !r.endsWith("/HEAD")).map((r) => r.slice(20));
  const have = new Set([...local, ...remote]), first = (names: string[]) => names.find((n) => have.has(n)) ?? null;
  return { name: d.split("/").pop()!, path: d, origin: origin || null, originIsGithub: /github\.com[:/]/.test(origin), currentBranch: current || null, localBranches: local, remoteBranches: remote,
    guess: { workBranch: current || null, stagingBranch: first(["staging", "uat", "stage", "develop-staging"]), prodBranch: first(["main", "master", "production", "prod"]), ...guessCommands(d) } };
}
function detect(folder: string) {
  const root = resolve(folder), dirs = isRepo(root) ? [root] : readdirSync(root).sort().map((n) => join(root, n)).filter((p) => { try { return statSync(p).isDirectory() && isRepo(p); } catch { return false; } });
  const gh = Bun.spawnSync(["gh", "auth", "status"], { stdout: "pipe", stderr: "pipe" }).exitCode === 0;
  return { folder: root, repos: dirs.map(detectRepo), gh: { installed: !!Bun.which("gh"), loggedIn: gh } };
}
const portFree = (port: number) => new Promise<boolean>((ok) => { const s = createServer(); s.once("error", () => ok(false)); s.listen(port, "127.0.0.1", () => s.close(() => ok(true))); });
function saveConfig(cfg: Config) { mkdirSync(dirname(CONFIG), { recursive: true }); writeFileSync(CONFIG, JSON.stringify(cfg, null, 2) + "\n"); }
async function setup(file?: string) {
  const a = readJson(file), cfg = loadConfig(), name: string = a.name ?? die("answers need a name"), folder = resolve(a.folder ?? die("answers need a folder"));
  if (!/^[A-Za-z0-9._-]+$/.test(name)) die("name may only hold letters, digits, . _ -");
  if (a.mergeToStaging !== "auto" && a.mergeToStaging !== "you") die('mergeToStaging must be "auto" or "you"');
  if (!Array.isArray(a.repos) || !a.repos.length) die("answers need at least one repo");
  const repos = a.repos.map((r: any) => ({ name: r.name ?? die("a repo needs a name"), path: resolve(r.path ?? die(`repo ${r.name} needs a path`)), workBranch: r.workBranch ?? die(`repo ${r.name} needs a workBranch`),
    stagingBranch: r.stagingBranch ?? null, prodBranch: r.prodBranch ?? null, ...(r.build ? { build: r.build } : {}), ...(r.test ? { test: r.test } : {}) }));
  const used = new Set(Object.entries(cfg.backends).filter(([n]) => n !== name).map(([, b]) => Number(new URL(b.url).port)));
  let port = cfg.backends[name]?.builtin ? Number(new URL(cfg.backends[name]!.url).port) : 4400;
  while (used.has(port) || (!(cfg.backends[name]?.builtin && port === Number(new URL(cfg.backends[name]!.url).port)) && !(await portFree(port)))) port++;
  const project = { name, port, dataDir: join(HOME, "data", name), mergeToStaging: a.mergeToStaging, repos };
  mkdirSync(project.dataDir, { recursive: true });
  cfg.backends[name] = { url: `http://127.0.0.1:${port}`, builtin: true, project }; cfg.projects[folder] = name;
  saveConfig(cfg);
  out(`Backend ${name} is set up for ${folder}: http://127.0.0.1:${port}`);
}
const answers = async (url: string) => { try { await fetch(url, { signal: AbortSignal.timeout(1500) }); return true; } catch { return false; } };
async function serveBuiltin(): Promise<void> {
  if (!BK.b.builtin || !BK.b.project) return die(`backend ${BK.name} is not built in: it is a service you run yourself (${BK.b.url}). See BACKEND.md.`);
  const file = join(dirname(realpathSync(process.argv[1]!)), "..", "engine", "serve.ts");
  if (!existsSync(file)) die("the built-in backend (engine/serve.ts) is missing: update ship-flow");
  out(`ship-flow dashboard: ${BK.b.url}/  (Ctrl+C to stop)`);
  await (await import(file)).serve(BK.name, BK.b.project);
}
async function up() {
  if (!BK.b.builtin) return out(BK.b.url + "/");
  if (await answers(BK.b.url)) return out(`ship-flow dashboard: ${BK.b.url}/`);
  const dir = BK.b.project?.dataDir ?? join(HOME, "data", BK.name); mkdirSync(dir, { recursive: true });
  const log = openSync(join(dir, "serve.log"), "a");
  Bun.spawn(["nohup", process.execPath, realpathSync(process.argv[1]!), "serve", "--backend", BK.name], { stdin: "ignore", stdout: log, stderr: log, env: process.env }).unref();
  for (let i = 0; i < 20; i++) { await sleep(500); if (await answers(BK.b.url)) return out(`ship-flow dashboard: ${BK.b.url}/`); }
  die(`the backend did not answer within 10 seconds. See ${join(dir, "serve.log")}`);
}

async function main() {
  if (cmd === "demo") return serveUi(Number(args[0] ?? 4390), true);
  if (cmd === "detect") return out(detect(args[0] ?? process.cwd()));
  if (cmd === "setup") return setup(args[0]);
  if (cmd === "backends") { // also says which backend this folder uses, so the skill can tell if setup is needed
    const cfg = loadConfig(), cwd = resolve(process.cwd());
    const forCwd = Object.entries(cfg.projects).filter(([dir]) => cwd === dir || cwd.startsWith(dir + "/")).sort((a, b) => b[0].length - a[0].length)[0]?.[1] ?? null;
    return out({ ...cfg, forCwd, cwd });
  }
  if (cmd === "serve" && args[0]) backendFlag = args[0];
  BK = pickBackend(["register", "ui", "up", "serve"].includes(cmd!) ? undefined : args[0]);
  switch (cmd) {
    case "serve": return serveBuiltin();
    case "up": return up();
    case "ui": return serveUi(Number(args[0] ?? 4390));
    case "register": {
      const plan = readJson(args[0]), sid = process.env.CLAUDE_CODE_SESSION_ID ?? die("CLAUDE_CODE_SESSION_ID is not set: run this from the Claude Code session that planned the work");
      const textFile = args.indexOf("--text"), text = textFile >= 0 ? readFileSync(need(args[textFile + 1], "--text file"), "utf8") : undefined;
      const r = await call("POST", "/terminal/adopt", { plan, session: sid, cwd: process.cwd(), text, stagingOnly: args.includes("--staging-only") });
      mkdirSync(join(HOME, "sessions"), { recursive: true }); mkdirSync(join(HOME, "plans"), { recursive: true });
      writeFileSync(join(HOME, "sessions", sid), JSON.stringify({ plan: r.id, backend: BK.name, hook: `${API()}/terminal/hook` })); // the hook posts only for a session with this file
      writeFileSync(planFile(r.id), JSON.stringify({ backend: BK.name, session: sid, cwd: process.cwd(), at: Date.now() }));
      writeFileSync(seenFile(r.id), "[]");
      out(`Registered ${r.id} on backend ${BK.name} (${URL_()}). Its page now shows it.`);
      return out(await todo(r.id));
    }
    case "attach": {
      // Takes over an existing plan from this session (e.g. one the old engine started).
      const id = need(args[0], "plan id"), sid = process.env.CLAUDE_CODE_SESSION_ID ?? die("CLAUDE_CODE_SESSION_ID is not set");
      await call("POST", `/terminal/${id}/attach`, { session: sid, cwd: process.cwd() });
      mkdirSync(join(HOME, "sessions"), { recursive: true }); mkdirSync(join(HOME, "plans"), { recursive: true });
      writeFileSync(join(HOME, "sessions", sid), JSON.stringify({ plan: id, backend: BK.name, hook: `${API()}/terminal/hook` }));
      writeFileSync(planFile(id), JSON.stringify({ backend: BK.name, session: sid, cwd: process.cwd(), at: Date.now() }));
      writeFileSync(seenFile(id), "[]");
      out(`${id} is now run from this session.`);
      return out(await todo(id));
    }
    case "status": return out(await todo(need(args[0], "plan id")));
    case "wait": {
      // Blocks until something new needs the terminal (a ready task, an error, the staging test, master PRs, the end), then prints it.
      const id = need(args[0], "plan id"), until = Date.now() + Number(args[1] ?? 3600) * 1000;
      const f = seenFile(id), seen = new Set<string>(existsSync(f) ? JSON.parse(readFileSync(f, "utf8")) : []);
      for (;;) {
        const t = await todo(id), fresh = t.items.filter((i: any) => !seen.has(i.key));
        if (fresh.length) {
          for (const i of fresh) seen.add(i.key);
          writeFileSync(f, JSON.stringify([...seen]));
          return out({ plan: t.plan, now: t.now, steps: t.steps, new: fresh, open: t.items.length - fresh.length, tasks: t.tasks });
        }
        if (Date.now() > until) return out({ plan: t.plan, now: t.now, steps: t.steps, new: [], note: "Nothing new yet; run ship wait again." });
        await sleep(8000);
      }
    }
    case "done": {
      // Hands a signed-off task to the engine, then waits for its merge into the plan branch.
      const [id, label, ...did] = args;
      await call("POST", `/terminal/${need(id, "plan id")}/done`, { task: need(label, "task label"), did: did.join(" ") });
      for (let i = 0; i < 90; i++) {
        await sleep(2000);
        const t = (await todo(id!)).tasks.find((x: any) => x.label === label);
        if (t?.status === "done") return out(`${label} merged into the plan branch.`);
        if (t?.status === "failed") return die(`${label} failed to merge: ${t.sub}`);
      }
      return out(`${label}: the merge is still running; check ship status ${id}.`);
    }
    case "round": return out(await call("POST", `/terminal/${need(args[0], "plan id")}/round`, { task: need(args[1], "task label"), ...readJson(args[2]) }));
    case "replan": return out(await call("POST", `/terminal/${need(args[0], "plan id")}/replan`, readJson(args[1])));
    case "note": return out(await call("POST", `/terminal/${need(args[0], "plan id")}/note`, { text: args.slice(1).join(" ") }));
    case "uat-guide": return out(await call("GET", "/terminal/uat-guide"));
    case "query": return out(await call("POST", "/terminal/query", { database: need(args[0], "database"), sql: need(args[1], "sql") }));
    case "uat-run": return out(await call("POST", `/terminal/${need(args[0], "plan id")}/uat-run`, { plan: readJson(args[1]) }));
    case "uat-recheck": return out(await call("POST", `/terminal/${need(args[0], "plan id")}/uat-recheck`, { checks: readJson(args[1]), waitMs: Number(args[2] ?? 20000) }));
    case "port-done": return out(await call("POST", `/terminal/${need(args[0], "plan id")}/port-answer`, { ok: !args.includes("--fail"), note: args.slice(1).filter((a) => a !== "--fail").join(" ") }));
    case "sweep-answer": return out(await call("POST", `/terminal/${need(args[0], "plan id")}/sweep-answer`, readJson(args[1])));
    case "uat-answer": return out(await call("POST", `/terminal/${need(args[0], "plan id")}/uat-answer`, readJson(args[1])));
    case "retry": return out(await call("POST", `/plans/${need(args[0], "plan id")}/retry`, {}));
    case "stop": return out(await call("POST", `/plans/${need(args[0], "plan id")}/stop`, {}));
    default:
      out(`ship <command>   (backend: --backend <name>, else the project folder in ~/.claude/ship/config.json)
  register <plan.json> [--staging-only] [--text plan.md]   register and start a plan from this session
  attach <P-xx>                    take over an existing plan from this session
  status <P-xx>                    what the plan and each task are doing
  wait <P-xx> [seconds]            block until something new needs this terminal (run in the background)
  done <P-xx> <T1> <what it did>   task signed off: merge it into the plan branch
  round <P-xx> <T1> <round.json>   record a review round (blocking, minor, reviewer)
  replan <P-xx> <patch.json>       change only the tasks named (update, redo, reopen, add, remove)
  note <P-xx> <text>               a line for the Tasks page
  uat-guide | query <db> <sql> | uat-run <P-xx> <plan.json> | uat-recheck <P-xx> <checks.json> [ms] | uat-answer <P-xx> <answer.json>
  sweep-answer <P-xx> <answer.json>  the last review's level for each minor finding
  port-done <P-xx> [--fail] [note]  a master conflict resolved (files staged, not committed), or --fail with why
  detect [folder]                  read only: the git repos, branches and build commands found (JSON)
  setup <answers.json>             write the built-in backend for a project (the master builds the file after asking you)
  up                               start the built-in backend if it is not running; print the dashboard link
  serve [name]                     run the built-in backend in the foreground
  ui [port]                        open the plans page for this backend (default port 4390)
  demo [port]                      the page with made-up plans, no backend needed
  retry <P-xx> | stop <P-xx> | backends  (env SHIP_CONFIG: another config file)`);
  }
}
await main();
